# Copy this file to .env.local for local dev, and set the same
# keys as Environment Variables in your Vercel project settings.

# MongoDB connection string (Atlas recommended for production/Vercel)
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio

# The public URL this site is deployed at (used for SEO/sitemap/OG tags)
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Comma-separated list of allowed origins for the API, or * for any
CORS_ORIGINS=*

# Resend email delivery for the contact form
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=vatsalchhatbar1234@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
